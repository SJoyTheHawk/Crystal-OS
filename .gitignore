# ESP-IDF and alternate local build directories.
/build/
/build-*/
/cmake-build-*/

# Python environments and test caches.
__pycache__/
*.py[cod]
/.venv/
/venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local dependencies, editor settings and generated configuration.
/managed_components/
/.vscode/
/sdkconfig
/sdkconfig.old
/dependencies.lock

# Host simulator builds, capture caches, and intermediate PPM frames.
# Keep published PNG/JPG assets in docs/images/ under version control.
# Use .cache/ for local --output-dir previews.
/.cache/
/compile_commands.json
/Testing/
/*.ppm
/sim/**/*.ppm
/docs/images/**/*.ppm

# Generated firmware, application packages and diagnostic output.
*.elf
*.capp
*.log
*.trace
*.core
*.swp
*.swo
*~

# macOS metadata.
.DS_Store
._*

# Local signing keys and saved device pairing sessions.
*.pem
/session.json
/closure-session.json
/.crystal_keys/
/.env
/.env.local

# Locally extracted video frames used during hardware validation.
video_frames_*/
video_frames/

# Release binaries are generated artifacts; keep source checksums/manifests.
/releases/*/crystal_os*.bin
/releases/*/crystal_os*.elf

# Registry integrity metadata no longer matches this locally patched component.
# Keep the vendored source itself tracked as Crystal's durable Brookesia override.
/components/esp-brookesia/.component_hash
/components/esp-brookesia/CHECKSUMS.json

# Local Wi-Fi capture metadata can contain device/network identifiers.
# Keep reviewed RESULTS.md summaries; raw logs are already ignored above.
/docs/test-evidence/wifi-checks/*.json
# Superseded local PM command reference; current steps are docs/WIFI_CHECKS.md.
/WIFI_FIX_COMMANDS.sh
