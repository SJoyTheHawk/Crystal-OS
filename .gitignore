# ESP-IDF and alternate local build directories.
/build/
/build-*/
/cmake-build-*/

# Python environments and test caches.
__pycache__/
*.py[cod]
/.venv/
/venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local dependencies, editor settings and generated configuration.
/managed_components/
/.vscode/
/sdkconfig
/sdkconfig.old
/dependencies.lock
/.cache/

# Generated firmware, application packages and diagnostic output.
*.elf
*.capp
*.log
*.trace

# macOS metadata.
.DS_Store
._*

# Local signing keys and saved device pairing sessions.
*.pem
/session.json
/closure-session.json

# Locally extracted video frames used during hardware validation.
video_frames_*/
video_frames/

# Release binaries are generated artifacts; keep source checksums/manifests.
/releases/*/crystal_os*.bin
/releases/*/crystal_os*.elf

# Registry integrity metadata no longer matches this locally patched component.
# Keep the vendored source itself tracked as Crystal's durable Brookesia override.
/components/esp-brookesia/.component_hash
/components/esp-brookesia/CHECKSUMS.json
